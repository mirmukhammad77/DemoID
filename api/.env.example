PORT=3000
HOST=127.0.0.1
# Localhost and 127.0.0.1 aliases are both allowed on this port.
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=data/demoid.sqlite
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=demoid-faces
MINIO_ACCESS_KEY=demoid-local
MINIO_SECRET_KEY=replace-with-your-local-minio-secret
AWS_REGION=us-east-1
# Use the normal AWS credential chain, for example AWS_PROFILE in your shell.
# Alternatively set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY privately.
FACE_SIMILARITY_THRESHOLD=95
