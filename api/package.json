{
  "name": "@demoid/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "db:migrate": "node --env-file-if-exists=.env dist/src/modules/database/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@smithy/node-http-handler": "^4.0.0",
    "better-sqlite3": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "typeorm": "^0.3.28",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "ts-node": "^10.9.2"
  }
}
