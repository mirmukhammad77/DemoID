DEEPFACE_HOST=127.0.0.1
DEEPFACE_PORT=8000
DEEPFACE_MODEL=VGG-Face
DEEPFACE_DETECTOR_BACKEND=opencv
DEEPFACE_DISTANCE_METRIC=cosine
DEEPFACE_BACKEND_ENGINE=onnx
# Optional cosine distance threshold from 0 to 2; blank uses the pinned model default.
DEEPFACE_DISTANCE_THRESHOLD=
# Optional writable parent of the .deepface model cache; default is this service folder.
# DEEPFACE_HOME=C:/path/to/model-cache
